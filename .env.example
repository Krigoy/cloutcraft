# --- App -------------------------------------------------------------------
# Optional fixed public URL. Leave empty and the app uses whatever host and
# port each request arrives on (so `next dev -p 4000` just works). Set it in
# production (e.g. https://cloutcraft.vercel.app) so OAuth redirect URIs match
# what you registered with each platform.
APP_URL=

# 32+ random characters. Encrypts OAuth tokens at rest. `npm run setup` fills this in.
APP_ENCRYPTION_KEY=

# --- Database ------------------------------------------------------------------
# Supabase → Connect → "Session pooler" (host *.pooler.supabase.com, port 5432).
# Not the direct connection (IPv6-only, unreachable from Vercel) and not the
# transaction pooler on 6543 (drops queries with this driver under load).
# Required on Vercel. Leave empty locally to use an embedded Postgres in ./data/pglite.
DATABASE_URL=
# PGLITE_PATH=./data/pglite

# --- Auth (Clerk) ---------------------------------------------------------------
# dashboard.clerk.com → your app → API keys. Locally you can leave both empty:
# Clerk's keyless mode creates a temporary development app on first run.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- AI coach ----------------------------------------------------------------
# Optional. Without any provider the dashboard still shows the deterministic
# insights. Configure one or more; with COACH_PROVIDER=auto the first
# configured one answers (Gemini → Groq → Anthropic → Ollama) and the others
# are fallbacks when it fails or is rate-limited.
GEMINI_API_KEY=                # free: https://aistudio.google.com/apikey
# GEMINI_MODEL=gemini-3.8-flash         # gemini-2.5-flash is closed to new API keys
GROQ_API_KEY=                  # free: https://console.groq.com/keys
# GROQ_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=             # paid
# ANTHROPIC_MODEL=claude-opus-5-5
# OLLAMA_URL=http://localhost:11434   # local, private; `ollama pull gpt-oss:20b`
# OLLAMA_MODEL=gpt-oss:20b
# COACH_PROVIDER=auto          # auto | gemini | groq | anthropic | ollama
# COACH_FALLBACK=true
# COACH_EFFORT=high            # reasoning effort where the model supports it
# COACH_MAX_TOKENS=16000

# --- Scheduler ---------------------------------------------------------------
# Shared secret for POST /api/cron/tick (required in production).
CRON_SECRET=
# Full re-sync cadence for every connected platform.
SYNC_INTERVAL_HOURS=6
# LIVE_FRESH_MINUTES=5         # "live now" if sampled within this many minutes
# LIVE_ENDED_MINUTES=10        # a stream counts as ended after this long without samples
# LIVE_MIN_SAMPLES=3           # samples needed before live stats are trusted

# --- Sync depth & analysis ---------------------------------------------------
# SYNC_LOOKBACK_DAYS=180       # how far back content is pulled (caps the windows below)
# SYNC_MAX_ITEMS=300           # per platform per sync
# OAUTH_STATE_TTL_MINUTES=10
# WINDOW_OPTIONS=30,90,180     # selectable analysis periods
# DEFAULT_WINDOW_DAYS=90
# ANALYSIS_TIMEZONE=Asia/Kolkata   # weekday analysis; defaults to the server's zone

# --- YouTube (Google Cloud Console → OAuth client, type "Web application") ---
# Enable "YouTube Data API v3" and "YouTube Analytics API".
# Redirect URI: <your app origin>/api/auth/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# --- Twitch (dev.twitch.tv/console → Applications) ---------------------------
# Redirect URI: <your app origin>/api/auth/twitch/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- TikTok (developers.tiktok.com → Login Kit + Display API) -----------------
# Redirect URI: <your app origin>/api/auth/tiktok/callback  (must be HTTPS)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
